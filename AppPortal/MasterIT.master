<%@ master language="C#" autoeventwireup="true" codefile="MasterIT.master.cs" inherits="MasterIT" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server" id="head">
	<title></title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- favicon -->
    <link runat="server" id="link1" rel="apple-touch-icon" sizes="180x180" />
    <link runat="server" id="link2" rel="icon" type="image/png" />
    <link runat="server" id="link3" rel="icon" type="image/png" sizes="16x16"/>
    <link runat="server" id="link4" rel="manifest" />
    <link runat="server" id="link5" rel="mask-icon" />
    <link runat="server" id="link6" rel="shortcut icon" />
    <meta runat="server" id="meta1" name="apple-mobile-web-app-title" />
    <meta runat="server" id="meta2" name="application-name" />
    <meta runat="server" id="meta3" name="theme-color" />

	<!-- CSS -->
	<link rel="stylesheet" href="/UI/CSS/bootstrap.css" />
	<link rel="stylesheet" href="/UI/CSS/bootstrap.font.css" />
	<link rel="stylesheet" href="/UI/CSS/custom.css" />
	<link rel="stylesheet" href="/UI/CSS/custom.portal.css" />

	<!-- JavaScript -->
	<script type="text/javascript" src="/UI/JS/jquery.js"></script>
	<script type="text/javascript" src="/UI/JS/bootstrap.js"></script>
	<script type="text/javascript" src="/UI/JS/custom.js"></script>
</head>
<body class="page">
	<!-- Menu -->
	<div class="navbar navbar-default navbar-fixed-top">
		<div class="container">
			<div class="navbar-header">
				<button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
					<span class="icon-bar"></span>
				</button>
                <a class="navbar-brand" href="HomeIT.aspx"><i class="icon-fire" style="color:red;">&nbsp;</i></a>
			</div>
			<div class="collapse navbar-collapse">
                <%--<ul class="nav navbar-nav navbar-left">
					<li class="dropdown">
                      <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Issue <span class="caret"></span></a>
                      <ul class="dropdown-menu">
                          <asp:Literal runat="server" ID="lit_menu_warning_system" />
                      </ul>
                    </li>
				</ul>--%>
				<ul class="nav navbar-nav navbar-right">
					<li>
						<a id="A1" runat="server" href="Home.aspx">
							<span class="visible-sm visible-md visible-lg"><i class="icon-home icon-large" title="Homepage"></i></span>
							<span class="visible-xs">Homepage</span>
						</a>
					</li>
					<li>
						<a id="A2" runat="server" href="~/?so=2">
							<span class="visible-sm visible-md visible-lg"><i class="icon-signout icon-large" title="Sign-Out"></i></span>
							<span class="visible-xs">Sign-Out</span>
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<!-- Content -->
	<div class="container">
		<h1>
			<small id="module" runat="server" />
			<br />
			<asp:contentplaceholder id="h1" runat="server" />
			<small>
				<asp:contentplaceholder id="h1_st" runat="server" />
			</small>
		</h1>
		<asp:contentplaceholder id="content" runat="server" />
	</div>

	<!-- Sistem Notifikasi -->
	<div id="callout" runat="server" class="alert alert-success">
		<i class="icon-spinner icon-spin icon-large"></i>
		Proses Berhasil
	</div>
	<asp:literal id="callout_script" runat="server" visible="false">
		<script type="text/javascript">
		    $('#callout').show();
		    $('#callout').fadeOut(5000);
		</script>
	</asp:literal>
</body>
</html>

<%@ master language="C#" autoeventwireup="true" codefile="MasterFile.master.cs" inherits="MasterFile" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
	<title></title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />

	<!-- CSS -->
	<link rel="stylesheet" href="/UI/CSS/bootstrap.css" />
	<link rel="stylesheet" href="/UI/CSS/bootstrap.datepicker.css" />
	<link rel="stylesheet" href="/UI/CSS/bootstrap.font.css" />
	<link rel="stylesheet" href="/UI/CSS/custom.css" />
    <link rel="stylesheet" href="/UI/Assets/select2-3.5.3/select2.css" />


	<!-- JavaScript -->
	<script type="text/javascript" src="/UI/JS/jquery.js"></script>
	<script type="text/javascript" src="/UI/JS/bootstrap.js"></script>
	<script type="text/javascript" src="/UI/JS/datepicker.js"></script>
	<script type="text/javascript" src="/UI/JS/custom.js"></script>
    <script type="text/javascript" src="/UI/Assets/select2-3.5.3/select2.js"></script>
</head>
<body class="file">
	<!-- Content -->
	<div class="container">
		<h1>
			<asp:contentplaceholder id="h1" runat="server" />
			<small>
				<asp:contentplaceholder id="h1_st" runat="server" />
			</small>
			<code class="pull-right hidden-sm hidden-xs">
				<asp:contentplaceholder id="h1_id" runat="server" />
			</code>
		</h1>
		<asp:contentplaceholder id="content" runat="server" />
	</div>

	<!-- Sistem Notifikasi -->
	<div id="callout" runat="server" class="alert alert-success">
		<i class="icon-spinner icon-spin icon-large"></i>
		Proses Berhasil
	</div>
	<asp:literal id="callout_script" runat="server" visible="false">
		<script type="text/javascript">
			$('#callout').show();
			$('#callout').fadeOut(5000);
			window.opener.location.reload(true);
		</script>
	</asp:literal>
</body>
</html>

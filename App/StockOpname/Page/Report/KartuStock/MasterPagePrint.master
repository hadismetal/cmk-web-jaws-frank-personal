<%@ master language="C#" autoeventwireup="true" codefile="MasterPagePrint.master.cs" inherits="MasterPage" %>


<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
	<title></title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />

	<!-- CSS -->
	<link rel="stylesheet" href="/UI/CSS/bootstrap.css" />
	<link rel="stylesheet" href="/UI/CSS/bootstrap.datepicker.css" />
	<link rel="stylesheet" href="/UI/CSS/bootstrap.font.css" />

	<!-- JavaScript -->
	<script type="text/javascript" src="/UI/JS/jquery.js"></script>
	<script type="text/javascript" src="/UI/JS/bootstrap.js"></script>
	<script type="text/javascript" src="/UI/JS/datepicker.js"></script>
	<script type="text/javascript" src="/UI/JS/custom.js"></script>	
    <link href="/UI/bootstrap5/css/bootstrap.min.css" rel="stylesheet">
    <script src="/UI/bootstrap5/js/bootstrap.bundle.min.js"></script>
	<style>
	@media print {
		@page {
			size: A4 portrait;
			margin: 4mm;
		}

		body {
			zoom: 0.75;               /* use zoom instead of transform */
			width: 100%;
			margin: 0;
			padding: 0;
		}
	}

	</style>

</head>
<body>
	

	<!-- Content -->
	<div style="overflow-x: hidden;">
		<asp:contentplaceholder id="content" runat="server" />
	</div>
		
		<script type="text/javascript">
		    setTimeout(() => {
				window.print();
			}, 300);
		</script>	
</body>
</html>

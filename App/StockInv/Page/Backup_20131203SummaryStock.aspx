                    <asp:TableHeaderCell ColumnSpan="7" style="text-align: center;" Width="670">Stock Exchange</asp:TableHeaderCell>
                    <asp:TableHeaderCell ColumnSpan="7" style="text-align: center;" Width="670">Stock Resell</asp:TableHeaderCell>
                </asp:TableHeaderRow>

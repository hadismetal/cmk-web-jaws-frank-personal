<%@ page language="C#" masterpagefile="~/MasterPage.master" autoeventwireup="true" codefile="Backup_20131203SummaryStock.aspx.cs" inherits="Page_Summary" %>

<asp:content contentplaceholderid="h1" runat="server">
	Summary
</asp:content>

<asp:content contentplaceholderid="content" runat="server">

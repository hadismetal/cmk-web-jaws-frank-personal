<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<%@ Register Src="Menu.ascx" TagName="Menu" TagPrefix="uc1" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- CSS -->
    <link rel="stylesheet" href="/UI/CSS/bootstrap.css" />
    <link rel="stylesheet" href="/UI/CSS/bootstrap.datepicker.css" />
    <link rel="stylesheet" href="/UI/CSS/bootstrap.font.css" />
    <link rel="stylesheet" href="/UI/CSS/custom.css" />
    <link rel="stylesheet" href="/UI/Assets/select2-3.5.3/select2.css" />
	<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.19/css/jquery.dataTables.css" />
    <link rel="stylesheet" href="/UI/CSS/sweetalert2.min.css"/>
    <link rel="stylesheet" href="/js/toastr/toastr.min.css" />

    <!-- JavaScript -->
    <script type="text/javascript" src="/UI/JS/jquery.js"></script>
    <script type="text/javascript" src="/UI/JS/bootstrap.js"></script>
    <script type="text/javascript" src="/UI/JS/datepicker.js"></script>
    <script type="text/javascript" src="/UI/JS/custom.js"></script>
    <script type="text/javascript" src="/UI/Assets/select2-3.5.3/select2.js"></script>
	<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.js"></script>    
    <script type="text/javascript" src="/UI/JS/sweetalert2.all.min.js"></script>
    <script type="text/javascript" src="/js/toastr/toastr.min.js"></script>
    
    <script>
        $.fn.ready(function () {
            // Spoiler
            $(document).on('click', '.spoiler-btn', function (e) {
                e.preventDefault()
                $(this).parent().children('.spoiler-body').collapse('toggle')
            });
        });

        //function bindEvent(element, eventName, eventHandler) {

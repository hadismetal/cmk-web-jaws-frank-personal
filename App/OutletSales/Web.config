<?xml version="1.0"?>
<configuration>
  <system.web>
    <httpRuntime targetFramework="4.5"/>
    <pages controlRenderingCompatibilityVersion="4.0"/>
    <compilation debug="true" targetFramework="4.5">
      <assemblies>
        <add assembly="System.Security, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Data.Linq, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Transactions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
      </assemblies>
    </compilation>
    <sessionState timeout="60"/>
    <!-- Eksplisit, bukan auto-generate: tanpa ini ASP.NET generate machineKey baru tiap kali
         worker process baru terbentuk (recycle terjadwal, idle-timeout, atau crash). ViewState
         yang sudah beredar di browser user dari proses lama jadi tidak valid begitu proses baru
         mulai - kandidat utama Base64/ViewState error. Key ini scoped ke OutletSales saja (beda
         dari AppPortal), digenerate sekali dan HARUS tetap sama di semua deploy berikutnya -
         jangan digenerate ulang kecuali sengaja mau invalidate semua ViewState yang beredar. -->
    <machineKey validationKey="D5CD7B9961205352704E902A86550DF84DC5EE7958E4B9EDF82BCE7B46218682EC3679C8A32F7EDAE2900AF9F2E91EE493AB960D5D75A5DE9FD8FAD479C5B582" decryptionKey="FFF3DBE181795356A2977E993E855E9582B147A9513A30C0F47610EC7112B637" validation="SHA1" decryption="AES"/>
  </system.web>
</configuration>
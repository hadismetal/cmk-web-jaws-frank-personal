<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<%@ Register Src="~/Menu.ascx" TagName="Menu" TagPrefix="uc1" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- CSS -->
    <link rel="stylesheet" href="/UI/CSS/bootstrap_reparasi.css" />
    <link rel="stylesheet" href="/UI/CSS/bootstrap.datepicker.css" />
    <link rel="stylesheet" href="/UI/CSS/bootstrap.font.css" />
    <link rel="stylesheet" href="/UI/CSS/custom.css" />
    <link rel="stylesheet" href="/UI/Assets/select2-3.5.3/select2.css" />
	<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.19/css/jquery.dataTables.css" />
	<link rel="stylesheet" href="/UI/CSS/jquery.inputpicker.css"/>
    <link href="/UI/bootstrap5/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="/lib/toastr/toastr.min.css" />

    <!-- JavaScript -->
    <script type="text/javascript" src="/UI/JS/jquery.js"></script>
    <script type="text/javascript" src="/UI/JS/bootstrap.js"></script>
    <script type="text/javascript" src="/UI/JS/datepicker.js"></script>
    <script type="text/javascript" src="/UI/JS/custom.js"></script>
    <script type="text/javascript" src="/UI/Assets/select2-3.5.3/select2.js"></script>
	<script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.js"></script>
	<script type="text/javascript" src="/UI/JS/jquery.inputpicker.js"></script>
    <script src="/UI/bootstrap5/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript" src="/lib/toastr/toastr.min.js"></script>
        <style>
      .popover {
        max-width: 600px; /* Set your desired width */
      }
    </style>
</head>
<body class="page">
    <!-- Menu -->
    <div class="navbar navbar-default navbar-fixed-top">
        <div class="container-fluid px-3">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
            </div>
            <div class="collapse navbar-collapse">
                <uc1:Menu ID="menu" runat="server" />
                <ul class="nav navbar-nav navbar-right">
                    <%--<li>
						<a runat="server" href="~/?so=3">
							<span class="visible-sm visible-md visible-lg"><i class="icon-question icon-large" title="FAQ"></i></span>
							<span class="visible-xs">FAQ</span>
						</a>
					</li>--%>
                    <li class="dropdown"><a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false"><asp:Literal runat="server" ID="lit_userstatus" /></a>
                        <ul class="dropdown-menu">
                            <li>
                                <asp:Literal runat="server" ID="lit_userstatus_info" />
                            </li>
                        </ul>
                    </li>
                    <li>
                        <a runat="server" href="~/?so=1">
                            <span class="visible-sm visible-md visible-lg"><i class="icon-home icon-large" title="Homepage"></i></span>
                            <span class="visible-xs">Homepage</span>
                        </a>
                    </li>
                    <li>
                        <a runat="server" href="~/?so=2">
                            <span class="visible-sm visible-md visible-lg"><i class="icon-signout icon-large" title="Sign-Out"></i></span>
                            <span class="visible-xs">Sign-Out</span>
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="container-fluid mt-5">
        <h1>
            <small id="module" runat="server" />
            <br />
            <asp:ContentPlaceHolder ID="h1" runat="server" />
            <small>
                <asp:ContentPlaceHolder ID="h1_st" runat="server" />
            </small>
        </h1>
        <asp:ContentPlaceHolder ID="content" runat="server" />
    </div>
</body>
</html>

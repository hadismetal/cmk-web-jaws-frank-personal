<%@ master language="C#" autoeventwireup="true" codefile="MasterPageExport.master.cs" inherits="MasterPageExport" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
	<title></title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>
<body class="page">
	
	<!-- Content -->
	<div class="container">
		<h1>
			<small id="module" runat="server" />
			<br />
			<asp:contentplaceholder id="h1" runat="server" />
			<small>
				<asp:contentplaceholder id="h1_st" runat="server" />
			</small>
		</h1>
		<asp:contentplaceholder id="content" runat="server" />
	</div>
</body>
</html>
